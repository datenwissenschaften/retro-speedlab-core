from enum import Enum
from typing import Any

import numpy as np
from numpy.typing import NDArray
from stable_retro import data as data

class State(Enum):
    DEFAULT = -1
    NONE = 0

class Actions(Enum):
    ALL = 0
    FILTERED = 1
    DISCRETE = 2
    MULTI_DISCRETE = 3

class Movie:
    def __init__(self, path: str) -> None: ...
    def get_game(self) -> str: ...
    def get_state(self) -> bytes: ...
    def set_state(self, state: bytes) -> None: ...
    def step(self) -> bool: ...
    def get_key(self, key: int, player: int) -> bool: ...

class RetroEmulator:
    def get_state(self) -> bytes: ...
    def set_state(self, state: bytes) -> bool: ...
    def get_screen(self) -> NDArray[np.uint8]: ...
    def get_screen_rate(self) -> float: ...
    def set_button_mask(self, mask: NDArray[np.uint8], player: int) -> None: ...
    def step(self) -> None: ...

class RetroEnv:
    em: RetroEmulator
    data: data.GameData
    movie: Movie | None
    movie_id: int
    movie_path: str | None
    gamename: str
    statename: str | None
    initial_state: bytes | None
    buttons: list[str]
    num_buttons: int
    def reset(self) -> tuple[NDArray[np.uint8], dict[str, Any]]: ...
    def step(self, a: NDArray[np.int8]) -> tuple[NDArray[np.uint8], float, bool, bool, dict[str, Any]]: ...
    def close(self) -> None: ...
    def action_to_array(self, a: NDArray[np.int8]) -> list[NDArray[np.uint8]]: ...
    def get_ram(self) -> NDArray[np.uint8]: ...
    def auto_record(self, path: str) -> None: ...
    def stop_record(self) -> None: ...

def make(game: str, state: State, *, render_mode: str, use_restricted_actions: Actions) -> RetroEnv: ...
